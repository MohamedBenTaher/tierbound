# Local Supabase (from `supabase status` after start)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Worker
WORKER_DATABASE_URL=postgresql://tierbound_worker:CHANGE_ME@127.0.0.1:54322/postgres
GITHUB_READ_TOKEN=
GROQ_API_KEY=
AGENT_CONFIG_PATH=worker/config/triage-drafter.toml

# Ingest / effector (Edge Function secrets)
GITHUB_WEBHOOK_SECRET=
# GitHub App private key is stored in Supabase Vault, not here
