# Local Supabase (from `supabase status` after start)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Worker
WORKER_DATABASE_URL=postgresql://tierbound_worker:CHANGE_ME@127.0.0.1:54322/postgres
GITHUB_READ_TOKEN=
GROQ_API_KEY=
AGENT_CONFIG_PATH=worker/config/triage-drafter.toml

# Ingest / effector (Edge Function secrets: `supabase functions serve --env-file .env`
# locally, `supabase secrets set` hosted)
GITHUB_WEBHOOK_SECRET=
# effect-github-comment (plan step 2.3). The GitHub App private key is an Edge
# Function secret, not a Vault entry: the effector connects as the restricted
# tierbound_effector role, which has no Vault access. One line, newlines as \n.
EFFECTOR_DATABASE_URL=postgresql://tierbound_effector:tierbound-local-only@db:5432/postgres
EFFECTOR_WEBHOOK_SECRET=tierbound-local-only
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_MS=10000
# EFFECT_LEASE_SECONDS=60
